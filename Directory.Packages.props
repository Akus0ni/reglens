<Project>
  <!-- Central Package Management (spec 0001, R1.2): no Version= on any PackageReference in a .csproj. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Application">
    <!-- 10.x on purpose: OllamaSharp 5.5.2 is built against Microsoft.Extensions.AI 10.8.0; 11.x is unverified with it. -->
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.1" />
    <!-- The abstract HybridCache lives here (spec 0003); the implementation is in Microsoft.Extensions.Caching.Hybrid. -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Infrastructure">
    <!-- Npgsql 10.x, not 11: Pgvector 0.3.2 is built against Npgsql 8.x and 11 is unverified (spec 0001, P7). -->
    <PackageVersion Include="Npgsql" Version="10.0.4" />
    <PackageVersion Include="Pgvector" Version="0.3.2" />
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="OllamaSharp" Version="5.5.2" />
    <!-- Anthropic 13.12.0 needs Microsoft.Extensions.AI.Abstractions >= 10.5.1 (nuspec); we pin 10.11.1 (spec 0003). -->
    <PackageVersion Include="Anthropic" Version="13.12.0" />
    <!-- 10.x, not 11.x: stays on the same line as the rest of Microsoft.Extensions.* (spec 0003). -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.1" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.1" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Hosts">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.17.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
  </ItemGroup>
</Project>
