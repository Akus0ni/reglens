{
  "Urls": "http://127.0.0.1:5180",
  "ConnectionStrings": {
    "Redis": "127.0.0.1:6379,abortConnect=false,connectTimeout=1000,syncTimeout=500,asyncTimeout=500"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http": "Warning",
      "Polly": "Warning"
    }
  },
  "Ollama": {
    "Endpoint": "http://localhost:11434",
    "EmbeddingModel": "nomic-embed-text",
    "AttemptTimeoutSeconds": 45,
    "TotalTimeoutSeconds": 90
  },
  "Search": {
    "QueryPrefix": "search_query: ",
    "CandidatesPerSide": 40,
    "DefaultTopK": 8,
    "MaxTopK": 20,
    "MaxQueryLength": 500
  },
  "Answers": {
    "Model": "claude-sonnet-5-5",
    "Effort": "Medium",
    "MaxOutputTokens": 8192,
    "SimilarityFloor": 0.60,
    "CacheHours": 24,
    "LocalCacheHours": 1,
    "RequestTimeoutSeconds": 60,
    "MaxRetries": 2
  }
}
