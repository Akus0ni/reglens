<Project Sdk="Microsoft.NET.Sdk">

  <!-- Eval runner (spec 0004, D45): a console composition root. Run from the repository root so evals/ resolves.
       Never part of `dotnet test`; paid runs need the confirm-spend flag. Reads the API's user-secrets (R4.13). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Quality" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RegLens.Application\RegLens.Application.csproj" />
    <ProjectReference Include="..\RegLens.Infrastructure\RegLens.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
